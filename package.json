{
  "name": "worktree-review",
  "displayName": "Worktree Review",
  "description": "Review Git worktree branches from your current repository without switching branches.",
  "version": "0.2.0",
  "publisher": "zfan2356",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Worktree Review only reads Git metadata and opens local diff views for the current workspace."
    }
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:worktreeReview.worktrees",
    "onCommand:worktreeReview.refresh",
    "onCommand:worktreeReview.selectBaseRef",
    "onCommand:worktreeReview.selectWorktree",
    "onCommand:worktreeReview.selectMode",
    "onCommand:worktreeReview.openCurrentFileReview",
    "onCommand:worktreeReview.openChangedFile",
    "onCommand:worktreeReview.copyWorktreePath"
  ],
  "contributes": {
    "configuration": {
      "title": "Worktree Review",
      "properties": {
        "worktreeReview.gitPath": {
          "type": "string",
          "default": "git",
          "description": "Path to the Git executable."
        },
        "worktreeReview.includeCurrentWorktree": {
          "type": "boolean",
          "default": false,
          "description": "Show the current workspace worktree in the review list."
        }
      }
    },
    "commands": [
      {
        "command": "worktreeReview.refresh",
        "title": "Refresh",
        "category": "Worktree Review",
        "icon": "$(refresh)"
      },
      {
        "command": "worktreeReview.selectBaseRef",
        "title": "Select Base Ref",
        "category": "Worktree Review",
        "icon": "$(git-branch)"
      },
      {
        "command": "worktreeReview.selectWorktree",
        "title": "Select Worktree",
        "category": "Worktree Review",
        "icon": "$(git-branch)"
      },
      {
        "command": "worktreeReview.selectMode",
        "title": "Select Mode",
        "category": "Worktree Review",
        "icon": "$(settings)"
      },
      {
        "command": "worktreeReview.openCurrentFileReview",
        "title": "Open Current File Review",
        "category": "Worktree Review",
        "icon": "$(diff)"
      },
      {
        "command": "worktreeReview.openChangedFile",
        "title": "Open Changed File",
        "category": "Worktree Review",
        "icon": "$(list-selection)"
      },
      {
        "command": "worktreeReview.copyWorktreePath",
        "title": "Copy Worktree Path",
        "category": "Worktree Review",
        "icon": "$(copy)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "worktreeReview",
          "title": "Worktree Review",
          "icon": "resources/worktree-review.svg"
        }
      ]
    },
    "views": {
      "worktreeReview": [
        {
          "id": "worktreeReview.worktrees",
          "name": "Worktrees"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "worktreeReview.refresh",
          "when": "view == worktreeReview.worktrees",
          "group": "navigation"
        },
        {
          "command": "worktreeReview.selectBaseRef",
          "when": "view == worktreeReview.worktrees",
          "group": "navigation"
        },
        {
          "command": "worktreeReview.selectMode",
          "when": "view == worktreeReview.worktrees",
          "group": "navigation"
        },
        {
          "command": "worktreeReview.openChangedFile",
          "when": "view == worktreeReview.worktrees",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "worktreeReview.selectBaseRef",
          "when": "view == worktreeReview.worktrees && viewItem == repo",
          "group": "navigation"
        },
        {
          "command": "worktreeReview.selectWorktree",
          "when": "view == worktreeReview.worktrees && (viewItem == worktree || viewItem == worktreeActive)",
          "group": "inline"
        },
        {
          "command": "worktreeReview.copyWorktreePath",
          "when": "view == worktreeReview.worktrees && (viewItem == worktree || viewItem == worktreeActive)",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "worktreeReview.openCurrentFileReview",
          "when": "resourceScheme == file",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "lint": "node --check src/extension.js && node --check src/git-utils.js && node --check test/git-utils.test.js",
    "test": "node --test test/*.test.js",
    "check": "npm run lint && npm test",
    "package:vsix": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-vsix.ps1"
  },
  "devDependencies": {}
}
